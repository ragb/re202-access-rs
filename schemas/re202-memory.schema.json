{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Memory",
  "description": "Typed view of a 33-byte memory block.\n\nUsed for both stored slots (MEMORY MANUAL, MEMORY 1..=127) and the edit-buffer mirror at `20 00 00 00`. The address is what differentiates; the payload format is the same.",
  "type": "object",
  "required": [
    "bass",
    "echo_volume",
    "intensity",
    "mode",
    "repeat_rate",
    "reverb_sw",
    "reverb_volume",
    "saturation",
    "tap_sw",
    "tap_time_ms",
    "tape",
    "time_mode",
    "treble",
    "wow_flutter"
  ],
  "properties": {
    "bass": {
      "description": "Bass tone of the echo.",
      "allOf": [
        {
          "$ref": "#/definitions/RangedParam"
        }
      ]
    },
    "echo_volume": {
      "description": "Echo Volume — level of the wet (delayed) signal.",
      "allOf": [
        {
          "$ref": "#/definitions/RangedParam"
        }
      ]
    },
    "intensity": {
      "description": "Intensity — feedback amount (number of repeats).",
      "allOf": [
        {
          "$ref": "#/definitions/RangedParam"
        }
      ]
    },
    "mode": {
      "description": "Head-combination mode 1..12 — which playback heads are active.",
      "allOf": [
        {
          "$ref": "#/definitions/Mode"
        }
      ]
    },
    "repeat_rate": {
      "description": "Repeat Rate — echo speed / delay time.",
      "allOf": [
        {
          "$ref": "#/definitions/RangedParam"
        }
      ]
    },
    "reverb_sw": {
      "description": "Reverb on/off.",
      "type": "boolean"
    },
    "reverb_volume": {
      "description": "Reverb Volume.",
      "allOf": [
        {
          "$ref": "#/definitions/RangedParam"
        }
      ]
    },
    "saturation": {
      "description": "Saturation — tape overdrive amount.",
      "allOf": [
        {
          "$ref": "#/definitions/RangedParam"
        }
      ]
    },
    "tap_sw": {
      "description": "Tap on/off.",
      "type": "boolean"
    },
    "tap_time_ms": {
      "description": "Tap-tempo delay time in milliseconds (0..=2000). The effective ceiling depends on Time Mode — Normal 1000 ms, Long 2000 ms — and isn't enforced here.",
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "tape": {
      "description": "Tape age / character: New or Aged.",
      "allOf": [
        {
          "$ref": "#/definitions/Tape"
        }
      ]
    },
    "time_mode": {
      "description": "Per-memory delay-time range. Overrides the System Time Mode for this patch; the per-memory value wins for the tap-time ceiling.",
      "allOf": [
        {
          "$ref": "#/definitions/TimeMode"
        }
      ]
    },
    "treble": {
      "description": "Treble tone of the echo.",
      "allOf": [
        {
          "$ref": "#/definitions/RangedParam"
        }
      ]
    },
    "wow_flutter": {
      "description": "Wow & Flutter — tape pitch instability.",
      "allOf": [
        {
          "$ref": "#/definitions/RangedParam"
        }
      ]
    }
  },
  "definitions": {
    "Mode": {
      "description": "12 head-combination modes. Numbered to match the device's UI (Mode 1..12). Wire byte = `mode_number - 1` (0..=11).\n\nThe 12 modes select which combination of the 4 tape playback heads is active. From the official reference manual (\"Head Combinations for Each Mode\"): playback heads 2, 3, 4 have 2x, 3x, 4x the delay time of head 1. Modes 8-12 use head 4, which the original RE-201 didn't have. Mode 12 is the same all-four-heads combination as Mode 8 but with head positions optimized for a denser tail.",
      "oneOf": [
        {
          "description": "Head 1 only.",
          "type": "string",
          "enum": [
            "m1"
          ]
        },
        {
          "description": "Head 2 only.",
          "type": "string",
          "enum": [
            "m2"
          ]
        },
        {
          "description": "Head 3 only.",
          "type": "string",
          "enum": [
            "m3"
          ]
        },
        {
          "description": "Heads 1 + 2.",
          "type": "string",
          "enum": [
            "m4"
          ]
        },
        {
          "description": "Heads 2 + 3.",
          "type": "string",
          "enum": [
            "m5"
          ]
        },
        {
          "description": "Heads 1 + 3.",
          "type": "string",
          "enum": [
            "m6"
          ]
        },
        {
          "description": "Heads 1 + 2 + 3.",
          "type": "string",
          "enum": [
            "m7"
          ]
        },
        {
          "description": "Heads 1 + 4.",
          "type": "string",
          "enum": [
            "m8"
          ]
        },
        {
          "description": "Heads 3 + 4.",
          "type": "string",
          "enum": [
            "m9"
          ]
        },
        {
          "description": "Heads 1 + 3 + 4.",
          "type": "string",
          "enum": [
            "m10"
          ]
        },
        {
          "description": "Heads 1 + 2 + 4.",
          "type": "string",
          "enum": [
            "m11"
          ]
        },
        {
          "description": "All four heads, dense arrangement (head positions optimized for thicker tail).",
          "type": "string",
          "enum": [
            "m12"
          ]
        }
      ]
    },
    "RangedParam": {
      "description": "An echo parameter that an expression pedal can sweep: `value` is the current setting and `min`/`max` bound the pedal's range. All three are 0..=127.",
      "type": "object",
      "required": [
        "max",
        "min",
        "value"
      ],
      "properties": {
        "max": {
          "description": "Upper bound of the expression-pedal sweep.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "min": {
          "description": "Lower bound of the expression-pedal sweep.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "value": {
          "description": "Current setting.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        }
      }
    },
    "Tape": {
      "description": "Tape age / character — New (bright) or Aged (worn, darker).",
      "type": "string",
      "enum": [
        "new",
        "aged"
      ]
    },
    "TimeMode": {
      "description": "Delay-time range: Normal (≤1000 ms) or Long (≤2000 ms).",
      "type": "string",
      "enum": [
        "normal",
        "long"
      ]
    }
  }
}
